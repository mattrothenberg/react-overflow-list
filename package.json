{
  "name": "react-overflow-list",
  "version": "0.5.0",
  "description": "A hooks-based, dependency-free port of the Blueprint OverflowList component.",
  "author": "Matt Rothenberg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattrothenberg/react-overflow-list.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.15.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build",
    "storybook": "start-storybook -p 6006",
    "build-storybook": "build-storybook",
    "example": "vite example --open"
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "size-limit": [
    {
      "path": "dist/index.mjs",
      "limit": "3 KB"
    }
  ],
  "devDependencies": {
    "@babel/core": "^7.15.5",
    "@radix-ui/react-popover": "^0.1.0",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@storybook/addon-essentials": "^6.3.8",
    "@storybook/addon-info": "^5.3.21",
    "@storybook/addon-links": "^6.3.8",
    "@storybook/addon-postcss": "^2.0.0",
    "@storybook/addons": "^6.3.8",
    "@storybook/react": "^6.3.8",
    "@types/react": "^17.0.21",
    "@types/react-dom": "^17.0.9",
    "@types/react-tagsinput": "^3.19.8",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.3.4",
    "babel-loader": "^8.2.2",
    "boring-avatars": "^1.5.8",
    "classcat": "^5.0.3",
    "faker": "^5.5.3",
    "jsdom": "^26.1.0",
    "postcss": "^8.3.6",
    "prettier": "^3.6.2",
    "re-resizable": "^6.9.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-icons": "^4.2.0",
    "react-is": "^17.0.2",
    "react-tagsinput": "^3.19.0",
    "react-use": "^17.3.1",
    "size-limit": "^11.2.0",
    "tailwindcss": "^2.2.15",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
