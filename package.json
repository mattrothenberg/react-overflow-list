{
  "name": "react-overflow-list",
  "version": "0.6.0",
  "description": "A hooks-based, dependency-free port of the Blueprint OverflowList component.",
  "author": "Matt Rothenberg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattrothenberg/react-overflow-list.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "example": "vite example --open",
    "example:build": "vite build example"
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "size-limit": [
    {
      "path": "dist/index.mjs",
      "limit": "3 KB"
    }
  ],
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-tagsinput": "^3.19.8",
    "@vitejs/plugin-react": "^5.0.4",
    "boring-avatars": "^2.0.4",
    "classcat": "^5.0.3",
    "faker": "^5.5.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "prop-types": "^15.8.1",
    "re-resizable": "^6.9.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^4.2.0",
    "react-is": "^19.3.0",
    "react-tagsinput": "^3.19.0",
    "react-use": "^17.3.1",
    "size-limit": "^11.2.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
